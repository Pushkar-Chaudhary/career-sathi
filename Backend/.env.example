# Required
NODE_ENV=production
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_GENAI_API_KEY=replace-with-your-gemini-api-key
FRONTEND_URL=https://your-production-domain.com

# Optional: required only to enable password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
